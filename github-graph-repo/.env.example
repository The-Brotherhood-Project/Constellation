PORT=10000
APP_MODE="docker | production | local"
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/brotherhood-github-graph-repo"
UCAN_SERVICE_URL="http://ucan-service:7600"
ENV_FILE_PATH="/github-graph-repo/credentials/.env"
GITHUB_TOKEN="your-github-account-api-token"
NOSTR_RELAY_URLS=["list-of-relay-urls-this-service-is-connected-to"]

LATEST_API_VERSION="1"
COPYRIGHT_NOTICE="Copyright (c) 2026 The Brotherhood Project Developers"
PUBLIC_REPO_URL="https://github.com/The-Brotherhood-Project/Constellation"
SERVICE_NAME="The Brotherhood GitHub Graph Repo Service"
SERVICE_DESC="A service for managing graphs in The Brotherhood Project"
SERVICE_URL="url-where-this-service-is-hosted-publicly"
