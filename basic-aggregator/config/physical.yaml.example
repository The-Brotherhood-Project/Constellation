# Physical Infrastructure and Hosting Configuration Example
#
# Configures running service instances, host nodes, and deployment endpoints.
# The builder probes 'host_url' at '/metadata' (or extracts <meta name="service-metadata">
# for static HTML sites).
# Matches the API service manifest schemas: service_name, service_desc, service_type,
# service_operator, service_did, latest_api_version, status, etc.
# NOTE: The published manifest retrieved from the host endpoint overrides editorial defaults below.

instances:
  # 'id': Unique instance identifier
  - id: seed-relay
    # 'host_url': Single entry URL to the host. Must expose /metadata for servers or service-metadata for static web apps
    host_url: "http://localhost:27000"
    # 'service_name': Fallback instance display name if host is unreachable
    service_name: "Seed Nostr Relay Instance"
    # 'service_operator': Entity or individual operating the node
    service_operator: "The Brotherhood Core"
    # 'service_did': Decentralized Identifier (DID) of the node/service
    service_did: "did:key:z6MkhaXgBZDvotDkL5257faiz48Z8x288ce65993"
    # 'service_type': Type of the service (e.g. 'Relay', 'Repository', 'Static Web Application')
    service_type: "Relay"
    # 'status': Operational status ('Active', 'Online', 'Degraded', 'Offline')
    status: "Active"
    # 'service_desc': Overview of the running instance and purpose
    service_desc: "Primary seed Nostr relay instance coordinating decentralized event distribution."
    # 'latest_api_version': API version string (e.g. 'v1'). Static sites leave this blank or omitted
    latest_api_version: "v1"
    # 'tags': Classification and environment tags ('["Seed", "Relay", "Production", "Nostr"]')
    tags: '["Seed", "Relay", "Production", "Nostr"]'
    # 'featured': Boolean. Visual priority highlight in the physical directory
    featured: true

  - id: seed-graph-repo
    host_url: "http://localhost:10000"
    service_name: "GitHub Graph Storage Node"
    service_operator: "The Brotherhood Core"
    service_did: "did:key:z6MkiTBz1ymuepAQ4HEHYSF1H8quG5GLdmECBCa9"
    service_type: "Repository"
    status: "Active"
    service_desc: "GitHub-backed knowledge graph snapshot storage and conversion service."
    latest_api_version: "v1"
    tags: '["Storage", "Git", "Knowledge Graph", "Production"]'
    featured: true

  - id: seed-web-curator
    host_url: "http://localhost:5500/web-curator-lab/index.html"
    service_name: "Web Curator Lab Host"
    service_operator: "The Brotherhood Project Developers"
    # Static sites do not expose an API or require a service_did, so leaving it blank is fully supported
    service_did: ""
    service_type: "Curator Lab"
    status: "Active"
    service_desc: "Static web deployment host for standalone offline Web Curator Lab."
    latest_api_version: ""
    tags: '["Web Host", "Static", "Curator"]'
    featured: false

  - id: seed-web-casey
    host_url: "http://localhost:5500/web-casey/index.html"
    service_name: "Web Casey Assessment Host"
    service_operator: "The Brotherhood Project Developers"
    service_did: ""
    service_type: "Knowledge Collector"
    status: "Active"
    service_desc: "Static deployment host for Casey capability assessment application."
    latest_api_version: ""
    tags: '["Web Host", "Static", "Casey"]'
    featured: false
